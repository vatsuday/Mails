# Copy this file to .env and fill in the values. Everything is optional for local testing.

APP_NAME=Company Mail
# Public web address, used in unsubscribe links (e.g. https://mail.yourcompany.com). Empty = taken from the browser.
APP_URL=

# PostgreSQL / Supabase connection string (use the pooler URL on Vercel). Empty = local embedded database in data/pgdata.
DATABASE_URL=

# Long random text. Encrypts the saved SMTP password and signs unsubscribe links. REQUIRED on Vercel; never change it later.
APP_SECRET=

# First admin account (created only when the database has no users yet).
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=Admin@123

# Timezone for "sent today" and the daily limit.
APP_TIMEZONE=Asia/Kolkata

# Optional SMTP defaults. Admins can set/override these in the website under Admin → Email settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
